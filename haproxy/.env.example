# ./haproxy/.env.example

# ==== Verzija ====
# LTS grana, alpine varijanta je manja
HAPROXY_VERSION=3.0-alpine

# ==== Portovi na hostu ====
HAPROXY_HTTP_PORT=80
HAPROXY_HTTPS_PORT=443
HAPROXY_STATS_PORT=8404

# ==== Stats stranica ====
# Kredencijali za pristup statistici na portu 8404
HAPROXY_STATS_USER=admin
HAPROXY_STATS_PASSWORD=promeni_me_stats
