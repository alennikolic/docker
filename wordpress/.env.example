# ./wordpress/.env.example

# ==== Verzije slika ====
# Fiksiraj PHP verziju da nadogradnja ne dodje neocekivano
WP_VERSION=6.7-php8.3-apache
MARIADB_VERSION=11.4

# ==== Baza ====
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=promeni_me_wp
WP_DB_ROOT_PASSWORD=promeni_me_root

# Prefiks tabela - promena podrazumevanog wp_ je sitna mera protiv
# automatizovanih napada. Mora se postaviti PRE prve instalacije.
WP_TABLE_PREFIX=wp_

# ==== Portovi na hostu ====
WP_PORT=8081
# phpMyAdmin (pokrece se samo sa --profile tools)
PMA_PORT=8082
