# ./portainer/.env.example

# ==== Verzija ====
# Konkretan tag umesto "latest" da nadogradnja bude kontrolisana
PORTAINER_VERSION=2.21.4

# ==== Portovi na hostu ====
# HTTPS web interfejs (preporuceni nacin pristupa)
PORTAINER_HTTPS_PORT=9443
# Tunel za Edge agente na udaljenim masinama
PORTAINER_EDGE_PORT=8000
